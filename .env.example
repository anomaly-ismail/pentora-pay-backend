# ─── Uygulama ─────────────────────────────────────────────────────────────────
APP_NAME=GuvenlIOdeme-Backend
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
DEBUG=true

# ─── Sunucu ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ─── Güvenlik — Pentora İmza Anahtarları ─────────────────────────────────────
# HMAC-SHA256 için gizli anahtar (üretimde 64+ karakter rastgele değer)
PENTORA_SIGNATURE_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM

# X-Pentora-GRAuth — AES-256-GCM + HMAC-SHA3-512 + Argon2id pepper
# En az 64 karakter! Üretmek için:
#   python -c "import secrets; print(secrets.token_hex(64))"
# UYARI (M-9): Aşağıdaki örnek değer YALNIZCA placeholder; üretime ASLA kopyalama.
# Üretim deploy'undan önce yukarıdaki komutla yeni bir değer üret.
PENTORA_GRAUTH_SECRET=REPLACE_ME__GENERATE_WITH__python_-c_import_secrets_print_secrets_token_hex_64

# Argon2id Parametreleri (varsayılan: RFC 9106 maksimum profil)
# Dikkat: memory_cost↑ güvenlik↑ ama sunucu RAM'i artar
ARGON2_TIME_COST=4
ARGON2_MEMORY_COST_KB=1048576
ARGON2_PARALLELISM=4

# X-Pentora-SQL — SQL tespit katmanı aktif mi?
PENTORA_SQL_GUARD_ENABLED=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://guvenliodeme.example.com,https://pentorasec.online,https://www.pentorasec.online
CORS_ALLOW_CREDENTIALS=true

# ─── CSRF (M-21) — Payment portal POST allowlist ─────────────────────────────
# Boş bırakılırsa CORS_ALLOWED_ORIGINS fallback olarak kullanılır.
CSRF_ALLOWED_ORIGINS=

# ─── Trusted Proxy (H-3) ──────────────────────────────────────────────────────
# Yalnızca bu IP'lerden gelen X-Forwarded-For / CF-Connecting-IP / X-Real-IP
# header'ları "gerçek istemci IP'si" olarak kabul edilir.
# Cloudflare Tunnel (cloudflared local proxy):  127.0.0.1,::1
# Nginx local reverse proxy:                    127.0.0.1
TRUSTED_PROXY_IPS=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ─── JWT ──────────────────────────────────────────────────────────────────────
# JWT_SECRET üret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_ALGORITHM=HS256
JWT_SECRET=REPLACE_ME__GENERATE_WITH__python_-c_import_secrets_print_secrets_token_hex_64
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── TCKN Pepper (HMAC-SHA3-512 indeksleme — ASLA loglanmaz) ──────────────────
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
TCKN_PEPPER=REPLACE_ME__GENERATE_WITH__python_-c_import_secrets_print_secrets_token_hex_32

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guvenliodeme
POSTGRES_USER=guvenliodeme_app
POSTGRES_PASSWORD=REPLACE_ME

# ─── Admin SSO ────────────────────────────────────────────────────────────────
ADMIN_MAIL=admin@example.com
# ADMIN_PASS yalnızca dev fallback. Üretimde ADMIN_PASS_HASH (Argon2id) zorunlu.
ADMIN_PASS=REPLACE_ME_DEV_ONLY
# Üret: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('SIFRENIZ'))"
ADMIN_PASS_HASH=

# ─── Loglama ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | pretty

# ─── PayTR ────────────────────────────────────────────────────────────────────
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# ─── Push (Firebase Admin SDK Service Account) ───────────────────────────────
# Varsayılan dosya adı backend klasöründe aranır.
# İstersen dosya adını buradan override edebilirsin.
FIREBASE_SERVICE_ACCOUNT_FILE=pentora-pay-firebase-adminsdk-fbsvc-ea94983dab.json

# ─── Netgsm SMS (OTP gönderimi) ──────────────────────────────────────────
# https://www.netgsm.com.tr → API Hesabınız → Kullanıcı Kodu ve Şifre
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Gönderici başlığı — IYS'de kayıtlı marka adı (maks 11 karakter)
NETGSM_HEADER=PentoraPay
# Netgsm gelen SMS (ONAYLIYORUM) webhook gizli token — URL'ye eklenir
# Üret: python -c "import secrets; print(secrets.token_urlsafe(32))"
NETGSM_SMS_REPLY_SECRET=CHANGE_ME_RANDOM_TOKEN

# ─── Ödeme Portalı ─────────────────────────────────────────────────────────
PAYMENT_PORTAL_URL=https://pentorasec.online/pay
